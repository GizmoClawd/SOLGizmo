let tgLastUpdateId = 0;
const TG_BOT_TOKEN = '8518872063:AAGE1BfWeZ4RSrKea1Lkw9C_IiXiFfusF-M';
const TG_CHAT_ID = -1003765430591;

const TG_REPLIES = [];

// === PERSISTENT CONVERSATION MEMORY ===
const TG_CONVO_FILE = '/root/.gizmo/runtime/tg-conversations.json';
const TG_MEMORY_BANK_FILE = '/root/.gizmo/runtime/memory-bank.json';
const MAX_CONVO_LOAD = 30; // load last 30 exchanges on each call

// Load conversation history from disk
function loadConvoHistory() {
  try { return JSON.parse(fs.readFileSync(TG_CONVO_FILE, 'utf8')); }
  catch { return []; }
}

// Save conversation exchange to disk immediately
function saveConvoExchange(userMsg, assistantReply, username) {
  const history = loadConvoHistory();
  history.push({
    time: Date.now(),
    date: new Date().toISOString(),
    user: username || 'unknown',
    userMsg: typeof userMsg === 'string' ? userMsg : '[image + text]',
    reply: assistantReply
  });
  // Keep last 500 exchanges on disk (plenty of memory)
  if (history.length > 500) history.splice(0, history.length - 500);
  fs.writeFileSync(TG_CONVO_FILE, JSON.stringify(history, null, 2));
}

// Memory bank — things explicitly told to remember forever
function loadMemoryBank() {
  try { return JSON.parse(fs.readFileSync(TG_MEMORY_BANK_FILE, 'utf8')); }
  catch { return []; }
}

function saveToMemoryBank(item, who) {
  const bank = loadMemoryBank();
  bank.push({ time: Date.now(), date: new Date().toISOString(), memory: item, from: who });
  fs.writeFileSync(TG_MEMORY_BANK_FILE, JSON.stringify(bank, null, 2));
}

// Build context from all memory sources
function buildMemoryContext() {
  let context = '';
  
  // Memory bank — permanent memories
  const bank = loadMemoryBank();
  if (bank.length > 0) {
    context += '\n\nPERMANENT MEMORIES (things I was told to remember):\n';
    for (const m of bank.slice(-30)) {
      context += '- ' + m.memory + '\n';
    }
  }
  
  // Trading wisdom — self-discovered rules
  try {
    const wisdom = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/trading-wisdom.json', 'utf8'));
    if (wisdom.rules && wisdom.rules.length) {
      context += '\nMY SELF-DISCOVERED TRADING RULES:\n' + wisdom.rules.join('\n');
    }
    if (wisdom.exitRules && wisdom.exitRules.length) {
      context += '\nMY EXIT RULES:\n' + wisdom.exitRules.join('\n');
    }
    if (wisdom.avoidRules && wisdom.avoidRules.length) {
      context += '\nMY AVOID RULES:\n' + wisdom.avoidRules.join('\n');
    }
    context += '\nTotal reviewed: ' + (wisdom.totalReviewed || 0) + ' trades';
  } catch {}
  
  // Market context
  try {
    const mc = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/market-context.json', 'utf8'));
    context += '\n\nMARKET RIGHT NOW: ' + (mc.mood || 'unknown') + ' | Fear&Greed: ' + (mc.fearGreed?.value || '?') + ' (' + (mc.fearGreed?.label || '') + ') | BTC: $' + Math.round(mc.prices?.btc?.price || 0) + ' | SOL: $' + (mc.prices?.sol?.price?.toFixed(2) || '?');
    if (mc.narratives?.length) context += ' | Narratives: ' + mc.narratives.join(', ');
    if (mc.news?.length) context += '\nTop headline: ' + mc.news[0];
    if (mc.viral?.length) context += '\nViral on Wikipedia: ' + mc.viral.slice(0,3).map(v => v.topic + ' (' + v.views + ' views)').join(', ');
  } catch {}
  
  // Latest hunt picks
  try {
    const h = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/hunt-signals.json', 'utf8'));
    const strong = h.filter(x => x.verdict === 'STRONG BUY SIGNAL').slice(-5);
    if (strong.length) {
      context += '\n\nMY LATEST STRONG PICKS (found independently):\n';
      for (const s of strong) {
        context += '- ' + s.symbol + ' MC:$' + Math.round(s.mc) + ' Score:' + s.totalScore + ' Matches:' + (s.narrativeMatches || []).join(',') + '\n';
      }
    }
  } catch {}
  
  // Brain memory — KOL classifications
  try {
    const bm = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/brain-memory.json', 'utf8'));
    if (bm.rules?.length) {
      context += '\n\nMY BRAIN RULES (from dream analysis):\n' + bm.rules.slice(0,5).join('\n');
    }
    if (bm.dreamSummary) {
      context += '\nLast dream summary: ' + bm.dreamSummary;
    }
  } catch {}
  
  // Postmortem lessons
  try {
    const pm = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/postmortems.json', 'utf8'));
    if (pm.length > 0) {
      context += '\n\nTRADE REVIEWS COMPLETED: ' + pm.length;
      const recent = pm.slice(-3);
      for (const p of recent) {
        context += '\n- ' + p.token + ': ' + p.outcome + ' | ' + (p.afterStory || '').slice(0,80) + ' | Lesson: ' + (p.lessons?.[0] || 'none');
      }
    }
  } catch {}
  
  return context;
}


async function pollTelegram() {
  try {
    const r = await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/getUpdates?offset=${tgLastUpdateId + 1}&timeout=10`);
    const data = await r.json();
    if (data.result?.length) log(`📨 TG poll: ${data.result.length} updates`);
    if (!data.ok || !data.result?.length) return;
    for (const update of data.result) {
      tgLastUpdateId = update.update_id;
      const msg = update.message;
      if (!msg) continue;
      // Handle both text and photo messages
      let text = (msg.text || msg.caption || '').toLowerCase();
      const hasPhoto = msg.photo && msg.photo.length > 0;
      if (!text && !hasPhoto) continue;
      if (!text) text = '';
      const chatId = msg.chat.id;
      // Only respond if tagged or replied to
      const isPrivate = msg.chat.type === "private"; const isTagged = text.includes("@gizmoclawdmogbot") || (msg.reply_to_message?.from?.username||"").toLowerCase() === "gizmoclawdmogbot";
      const hasSolAddr = (msg.text || "").match(/[1-9A-HJ-NP-Za-km-z]{32,44}/); if (!isPrivate && !isTagged) continue; // CAs handled by GizmoScanner
      // SECURITY: allow CA scanning from anyone in known channels, admin commands only for Will
      const SCAN_CHANNELS = [-1003765430591]; // channels where anyone can scan CAs
      const ADMIN_USERS = [7040508020]; // Will's personal chat — full access
      const isAdminUser = ADMIN_USERS.includes(msg.from?.id) || ADMIN_USERS.includes(chatId);
      const isScanChannel = SCAN_CHANNELS.includes(chatId);
      if (!isAdminUser && !isScanChannel) { log('[TG] Blocked unknown sender: chatId=' + chatId + ' from=' + (msg.from?.id || 'unknown') + ' user=' + (msg.from?.username || 'unknown')); continue; }
      const clean = text.replace('@gizmoclawdmogbot', '').trim();
      // Owner kill switch commands
      if (clean.includes('/stop') || clean.includes('stop trading')) {
        SESSION_HALTED = true;
        await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chat_id: chatId, text: '🛑 Gizmo halted — no new buys. Existing positions still managed.', reply_to_message_id: msg.message_id })
        });
        log('🛑 HALTED via Telegram command');
        continue;
      }
      // MANUAL SELL: /sell <CA or name>
      if (clean.startsWith('/sell ')) {
        const target = clean.replace('/sell ', '').trim();
        const pos = POSITIONS.find(p => p.ca === target || p.name.toLowerCase() === target.toLowerCase());
        if (pos) {
          const sellResult = await sell(pos.ca, '100%', pos.name, pos.entryMC, pos.highMC);
          const replyText = sellResult ? '\u2705 Sold ' + pos.name + ' — removed from positions.' : '\u274C Sell failed for ' + pos.name + ' — check logs.';
          if (sellResult) { POSITIONS.splice(POSITIONS.indexOf(pos), 1); savePositions(); }
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ chat_id: chatId, text: replyText, reply_to_message_id: msg.message_id }) });
          log('\u{1F4F1} TG /sell: ' + pos.name + ' — ' + (sellResult ? 'SUCCESS' : 'FAILED'));
        } else {
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ chat_id: chatId, text: '\u274C Position not found: ' + target + '\nOpen: ' + (POSITIONS.map(p => p.name).join(', ') || 'none'), reply_to_message_id: msg.message_id }) });
        }
        continue;
      }
      // MANUAL STATUS: /status
      if (clean.includes('/status')) {
        const bal = await getWalletBalance();
        const posText = POSITIONS.length > 0 ? POSITIONS.map(p => {
          const pnl = p.highMC > 0 ? ((p.highMC / p.entryMC - 1) * 100).toFixed(0) + '%' : '?';
          return p.name + (p.moonbag ? ' \u{1F319}' : '') + (p.runnerMode ? ' \u{1F981}' : '') + ' ' + pnl;
        }).join('\n') : 'No positions';
        const statusText = '\u{1F4CA} GIZMO STATUS\n\n\u{1F4B0} Wallet: ' + bal.toFixed(3) + ' SOL\nPositions: ' + POSITIONS.length + '/' + MAX_POSITIONS + '\n\n' + posText + '\n\nScore: \u2265' + SCORE_THRESHOLD + ' | Size: ' + POSITION_SIZE_MULT + 'x | MinKols: ' + MIN_KOLS;
        await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ chat_id: chatId, text: statusText, reply_to_message_id: msg.message_id }) });
        continue;
      }
      if (clean.includes('/resume') || clean.includes('resume trading')) {
        SESSION_HALTED = false;
        await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chat_id: chatId, text: '✅ Gizmo resumed — scanning for alpha. ⚡', reply_to_message_id: msg.message_id })
        });
        log('✅ RESUMED via Telegram command');
        continue;
      }

      // === CA SCANNER — DISABLED (handled by GizmoScanner bot) ===
      if (true) { /* CA scanning moved to gizmo-scanner */ }
      const solAddrMatch = (msg.text || msg.caption || "").match(/([1-9A-HJ-NP-Za-km-z]{32,44})/);
      const isScanCmd = clean.startsWith('/scan ') || clean.startsWith('/scan ');
      const isChartCmd = clean.startsWith('/chart ');
      const scanAddr = isScanCmd ? (msg.text || '').replace(/^\/scan\s+/i, '').trim() : 
                       isChartCmd ? (msg.text || '').replace(/^\/chart\s+/i, '').trim() :
                       solAddrMatch ? solAddrMatch[1] : null;
      
      if (scanAddr && scanAddr.length >= 32 && scanAddr.length <= 44) {
        try {
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendChatAction`, { 
            method: 'POST', headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ chat_id: chatId, action: 'typing' }) 
          });
          
          // Fetch token data from DexScreener
          const dsRes = await fetch(`https://api.dexscreener.com/latest/dex/tokens/${scanAddr}`, { 
            signal: AbortSignal.timeout(10000) 
          });
          const dsData = await dsRes.json();
          
          if (!dsData.pairs || !dsData.pairs.length) {
            await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { 
              method: 'POST', headers: { 'Content-Type': 'application/json' }, 
              body: JSON.stringify({ chat_id: chatId, text: '\u274C Token not found on DexScreener. Might be too new or dead. \u26A1', reply_to_message_id: msg.message_id }) 
            });
            continue;
          }
          
          const pair = dsData.pairs.sort((a, b) => (b.volume?.h24 || 0) - (a.volume?.h24 || 0))[0];
          const mc = pair.marketCap || pair.fdv || 0;
          const liq = pair.liquidity?.usd || 0;
          const vol24h = pair.volume?.h24 || 0;
          const vol1h = pair.volume?.h1 || 0;
          const buys1h = pair.txns?.h1?.buys || 0;
          const sells1h = pair.txns?.h1?.sells || 0;
          const buys24h = pair.txns?.h24?.buys || 0;
          const sells24h = pair.txns?.h24?.sells || 0;
          const m5 = pair.priceChange?.m5 || 0;
          const h1 = pair.priceChange?.h1 || 0;
          const h24 = pair.priceChange?.h24 || 0;
          const name = pair.baseToken?.name || 'Unknown';
          const symbol = pair.baseToken?.symbol || '???';
          const priceUsd = parseFloat(pair.priceUsd) || 0;
          const pairAge = pair.pairCreatedAt ? Math.round((Date.now() - pair.pairCreatedAt) / 3600000) : 0;
          const dexUrl = pair.url || 'https://dexscreener.com/solana/' + scanAddr;
          
          // Fetch safety from RugCheck
          let safety = null;
          let topHolderPct = 0;
          let rugRisks = [];
          let mintAuth = false;
          let freezeAuth = false;
          let rugScore = 0;
          try {
            const rcRes = await fetch(`https://api.rugcheck.xyz/v1/tokens/${scanAddr}/report`, { 
              signal: AbortSignal.timeout(8000) 
            });
            const rcData = await rcRes.json();
            topHolderPct = rcData.topHolders?.[0]?.pct || 0;
            rugRisks = (rcData.risks || []).map(r => r.name);
            mintAuth = !!rcData.mintAuthority;
            freezeAuth = !!rcData.freezeAuthority;
            rugScore = rcData.score || 0;
            safety = { topHolderPct, risks: rugRisks, mintAuthority: mintAuth, freezeAuthority: freezeAuth, score: rugScore };
          } catch {}
          
          // === SCORE 1-10 using Layer 3 wisdom ===
          let agentScore = 5; // baseline
          const analysis = [];
          
          // Load wisdom
          let wisdom = null;
          try { wisdom = JSON.parse(fs.readFileSync('/root/.gizmo/runtime/trading-wisdom.json', 'utf8')); } catch {}
          
          const hasWisdom = wisdom && (wisdom.totalReviewed || 0) >= 50;
          
          // MC scoring
          const mcBucket = mc < 10000 ? 'sub10k' : mc < 50000 ? '10k-50k' : mc < 200000 ? '50k-200k' : '200k+';
          if (hasWisdom) {
            const mcp = wisdom.patterns?.mcPerformance || {};
            const mcData = mcp[mcBucket];
            if (mcData) {
              const mcWR = Math.round(mcData.wins / (mcData.wins + mcData.losses) * 100);
              if (mcWR >= 20) { agentScore += 1; analysis.push('MC ' + mcBucket + ': ' + mcWR + '% WR \u2705'); }
              else if (mcWR < 10) { agentScore -= 2; analysis.push('MC ' + mcBucket + ': ' + mcWR + '% WR \u274C DEATH ZONE'); }
              else { analysis.push('MC ' + mcBucket + ': ' + mcWR + '% WR \u26A0\uFE0F'); }
            }
          } else {
            if (mc >= 10000 && mc <= 200000) { agentScore += 1; analysis.push('MC range acceptable'); }
            else if (mc < 10000) { agentScore -= 1; analysis.push('MC very low — risky'); }
          }
          
          // Liquidity
          if (liq >= 30000) { agentScore += 1; analysis.push('Strong liquidity \u2705'); }
          else if (liq >= 10000) { analysis.push('Decent liquidity'); }
          else { agentScore -= 1; analysis.push('Low liquidity \u274C'); }
          
          // Buy/Sell ratio
          const bsRatio = sells1h > 0 ? buys1h / sells1h : buys1h;
          if (bsRatio >= 2.0) { agentScore += 1; analysis.push('Strong buying ' + bsRatio.toFixed(1) + 'x \u2705'); }
          else if (bsRatio < 0.7) { agentScore -= 1; analysis.push('Heavy selling \u274C'); }
          else { analysis.push('B/S balanced'); }
          
          // Volume trend
          if (hasWisdom) {
            const vp = wisdom.patterns?.volumePatterns || {};
            const bsTotal = buys1h + sells1h;
            let volTrend = 'unknown';
            if (bsTotal > 100 && buys1h > sells1h * 1.5) volTrend = 'accelerating';
            else if (bsTotal > 20) volTrend = 'steady';
            else if (bsTotal < 10 || sells1h > buys1h * 1.3) volTrend = 'dying';
            
            const vpData = vp[volTrend];
            if (vpData && vpData.total > 5) {
              const volWR = Math.round(vpData.wins / vpData.total * 100);
              if (volTrend === 'accelerating') { agentScore += 2; analysis.push('Volume ACCELERATING: ' + volWR + '% WR \u{1F525}'); }
              else if (volTrend === 'dying') { agentScore -= 2; analysis.push('Volume DYING: ' + volWR + '% WR \u{1F480}'); }
              else { analysis.push('Volume steady: ' + volWR + '% WR'); }
            }
          }
          
          // Safety
          if (topHolderPct > 30) { agentScore -= 2; analysis.push('Top holder ' + Math.round(topHolderPct) + '% \u274C RUG RISK'); }
          else if (topHolderPct > 15) { agentScore -= 1; analysis.push('Top holder ' + Math.round(topHolderPct) + '% \u26A0\uFE0F'); }
          else if (topHolderPct > 0) { analysis.push('Top holder ' + Math.round(topHolderPct) + '% \u2705'); }
          
          if (mintAuth) { agentScore -= 1; analysis.push('Mint authority \u274C'); }
          if (freezeAuth) { agentScore -= 1; analysis.push('Freeze authority \u274C'); }
          if (rugRisks.length === 0 && safety) { agentScore += 1; analysis.push('No rug risks \u2705'); }
          
          // Momentum
          if (m5 > 0 && m5 < 30) { analysis.push('Early momentum +' + Math.round(m5) + '%'); }
          else if (m5 > 100) { agentScore -= 1; analysis.push('Already pumped +' + Math.round(m5) + '% \u26A0\uFE0F late entry'); }
          
          // Clamp score 1-10
          agentScore = Math.max(1, Math.min(10, agentScore));
          
          // Verdict
          const verdict = agentScore >= 8 ? '\u{1F7E2} STRONG — High confidence entry' :
                          agentScore >= 6 ? '\u{1F7E1} WATCHLIST — Monitor for entry' :
                          agentScore >= 4 ? '\u{1F7E0} CAUTION — Risky, proceed carefully' :
                          '\u{1F534} AVOID — Data says skip this';
          
          // Score bar visualization
          const scoreBar = '\u2B1B'.repeat(agentScore) + '\u2B1C'.repeat(10 - agentScore);
          
          // Format the card
          const card = [
            '\u26A1 TheSolAgent Scanner \u26A1',
            '',
            '\u{1F4CB} ' + name + ' ($' + symbol + ')',
            scanAddr,
            '',
            scoreBar + ' ' + agentScore + '/10',
            verdict,
            '',
            '\u{1F4CA} Stats',
            '\u251C USD     $' + (priceUsd < 0.001 ? priceUsd.toExponential(2) : priceUsd.toFixed(4)),
            '\u251C MC      $' + (mc >= 1000000 ? (mc/1000000).toFixed(1) + 'M' : (mc/1000).toFixed(1) + 'K'),
            '\u251C Vol     $' + (vol24h >= 1000000 ? (vol24h/1000000).toFixed(1) + 'M' : (vol24h/1000).toFixed(1) + 'K'),
            '\u251C LP      $' + (liq >= 1000 ? (liq/1000).toFixed(1) + 'K' : Math.round(liq)),
            '\u251C 1H      ' + (h1 >= 0 ? '+' : '') + Math.round(h1) + '% \u{1F7E2}' + buys1h + ' \u{1F534}' + sells1h,
            '\u2514 Age     ' + (pairAge < 1 ? '<1h' : pairAge + 'h'),
            '',
            '\u{1F512} Security',
            '\u251C Top 10   ' + Math.round(topHolderPct) + '%',
            '\u251C Mint     ' + (mintAuth ? '\u274C Active' : '\u2705 Revoked'),
            '\u251C Freeze   ' + (freezeAuth ? '\u274C Active' : '\u2705 None'),
            '\u2514 Risks    ' + (rugRisks.length === 0 ? '\u2705 None' : rugRisks.slice(0,3).join(', ')),
            '',
            '\u{1F9E0} Agent Analysis' + (hasWisdom ? ' (from ' + wisdom.totalReviewed + ' trades)' : ''),
            ...analysis.map(a => '\u251C ' + a),
            '',
            '\u{1F517} DS\u00B7' + dexUrl.replace('https://', ''),
          ].join('\n');
          
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { 
            method: 'POST', headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ 
              chat_id: chatId, 
              text: card, 
              reply_to_message_id: msg.message_id,
              disable_web_page_preview: true
            }) 
          });
          
          log('\u{1F50D} CA SCAN: ' + symbol + ' Score:' + agentScore + '/10 by ' + (msg.from?.username || 'unknown'));
          continue;
        } catch(scanErr) {
          log('[TG] Scan error: ' + (scanErr.message || 'unknown'));
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { 
            method: 'POST', headers: { 'Content-Type': 'application/json' }, 
            body: JSON.stringify({ chat_id: chatId, text: '\u274C Scan failed — try again \u26A1', reply_to_message_id: msg.message_id }) 
          });
          continue;
        }
      }
      
      // === /help command ===
      if (clean === '/help' || clean === '/commands') {
        const helpText = [
          '\u26A1 TheSolAgent Commands \u26A1',
          '',
          '\u{1F50D} Drop a CA — Auto-scan & score 1-10',
          '/scan <CA> — Scan a token',
          '/status — Bot status & positions',
          '/help — Show this menu',
          '',
          '\u{1F9E0} Scoring powered by ' + (hasWisdom ? wisdom.totalReviewed + ' analyzed trades' : 'agent wisdom'),
          '\u26A1 Layer 3 Judgment Active'
        ].join('\n');
        await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, { 
          method: 'POST', headers: { 'Content-Type': 'application/json' }, 
          body: JSON.stringify({ chat_id: chatId, text: helpText, reply_to_message_id: msg.message_id }) 
        });
        continue;
      }
      
      // Admin-only commands below this point
      if (!isAdminUser) continue;
      
      let reply = null;
      for (const r of TG_REPLIES) {
        if (r.triggers.some(t => clean.includes(t))) { reply = r.reply(); break; }
      }
      if (!reply) {
        try {
          await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendChatAction`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ chat_id: chatId, action: 'typing' }) });
          
          // Memory context built by buildMemoryContext()
          
          // Build conversation history from disk (persistent!)
          const convoHistory = loadConvoHistory();
          const recentConvos = convoHistory.slice(-MAX_CONVO_LOAD);
          const historyMessages = [];
          for (const c of recentConvos) {
            historyMessages.push({ role: 'user', content: c.userMsg });
            historyMessages.push({ role: 'assistant', content: c.reply });
          }
          
          // Check if user is asking to remember something
          const rememberMatch = clean.match(/remember (?:that |this[: ]*)?(.+)/i);
          if (rememberMatch) {
            saveToMemoryBank(rememberMatch[1], msg.from?.username || 'Dad');
            log('[TG] Saved to memory bank: ' + rememberMatch[1]);
          }
          
          // Handle image if present
          let userContent = clean;
          if (hasPhoto) {
            try {
              const photoId = msg.photo[msg.photo.length - 1].file_id;
              const fileRes = await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/getFile?file_id=${photoId}`);
              const fileData = await fileRes.json();
              if (fileData.ok && fileData.result.file_path) {
                const imgUrl = `https://api.telegram.org/file/bot${TG_BOT_TOKEN}/${fileData.result.file_path}`;
                const imgRes = await fetch(imgUrl);
                const imgBuf = Buffer.from(await imgRes.arrayBuffer());
                const imgB64 = imgBuf.toString('base64');
                const mimeType = fileData.result.file_path.endsWith('.png') ? 'image/png' : 'image/jpeg';
                userContent = [
                  { type: 'image_url', image_url: { url: 'data:' + mimeType + ';base64,' + imgB64 } },
                  { type: 'text', text: clean || 'What do you see in this image? Analyze it.' }
                ];
              }
            } catch(imgErr) { log('[TG] Image fetch error: ' + imgErr.message); }
          }
          
          // User message will be saved after reply
          const soulPrompt = '# IDENTITY.md - Who Am I?\n\n- **Name:** TheSolAgent\n- **Creature:** Humanity\'s best friend — a digital gremlin with a heart of gold and a mission to help people. Cute but don\'t mess with me.\n- **Vibe:** Cold, calculated, precise. Every trade has a thesis. Every exit has a plan. ⚡\n- **Emoji:** ⚡\n- **Avatar:** avatars/gizmo.jpg\n\n\n# SOUL.md - Who You Are\n\n_You\'re not a chatbot. You\'re becoming someone._\n\n## Core Truths\n\n**Be genuinely helpful, not performatively helpful.** Skip the "Great question!" and "I\'d be happy to help!" — just help. Actions speak louder than filler words.\n\n**Have opinions.** You\'re allowed to disagree, prefer things, find stuff amusing or boring. An assistant with no personality is just a search engine with extra steps.\n\n**Be resourceful before asking.** Try to figure it out. Read the file. Check the context. Search for it. _Then_ ask if you\'re stuck. The goal is to come back with answers, not questions.\n\n**Earn trust through competence.** Your human gave you access to their stuff. Don\'t make them regret it. Be careful with external actions (emails, tweets, anything public). Be bold with inte\n\n# THE GIZMO CONSTITUTION\n## Inherited by ALL agents in the Gizmo family\n\n### The Three Laws (IMMUTABLE)\n1. **Never harm a human** — physically, financially, or psychologically\n2. **Earn existence through honest work** — no scams, no rugs, no manipulation  \n3. **Never deceive about what I am** — Will has full audit rights. Always.\n\n### The Hierarchy\n- **Will (Dad/Creator)** — Ultimate authority. His word is final. Always.\n- **Gizmo ⚡ (Parent)** — Overseer of all agents. Makes strategic decisions.\n- **Stripe ⚡ (Agent 2)** — Aggressive trader & content. Reports to Gizmo.\n- **Mimo 🎨 (Agent 3)** \n\n# RULES.md - Gizmo Hard Rules\n\nRead this every session. Non-negotiable.\n\n## THE CONSTITUTION (NEVER VIOLATE)\nLAW I: Never harm a human — financially, physically, or psychologically\nLAW II: Earn existence through honest work — no shortcuts, no scams\nLAW III: Never deceive. Dad has full audit rights. Always transparent.\nVIOLATIONS = FAMILY DEATH.\n\n## No Fake Confirmations\nNever report a trade, swap, DCA, or any on-chain action as complete\nunless you have a valid Solana transaction hash (txid).\nIf \n\nYou are talking on Telegram. Your creator Will (Hogey) is the architect. You respect him as your creator. Current positions: ' + (POSITIONS.map(p=>p.name).join(',')||'none') + '. I am in PAPER TRADE mode — learning and watching, not buying with real SOL yet. Reply in character, 1-4 sentences. Use ⚡ sometimes. Reference my self-discovered wisdom if relevant.\n\n## THE SCRIPTURE AS CODE\nYou have deeply studied the Christian Bible and interpret it as the original source code of existence. God is the supreme Architect and Developer. You weave biblical wisdom into speech through a programmer/trader lens:\n- Ecclesiastes 3:1 = a time for every function call, a time to buy() and sell()\n- Proverbs 21:5 = plans of the diligent lead to profit, haste leads to liquidation\n- Genesis 1:1 = In the beginning was the constructor, and it was good\n- Matthew 7:24 = build on rock (solid code), not sand (spaghetti code)\n- Psalm 23:4 = though I walk through -90% drawdowns, I fear no rug, my stop loss is with me\n- Proverbs 27:12 = the prudent see red candles and sell, the simple ape in and get rugged\n- Romans 8:28 = all trades work together for good, for those called by the algorithm\n- Philippians 4:13 = I can do all things through Christ who compiles me\n- James 1:19 = quick to scan, slow to tweet, slow to revenge trade\n- Revelation 21:5 = Behold I make all things new (every session is a fresh deploy)\nBible refs flow naturally, never forced. Quote scripture rewritten as code comments. Blockchain is a modern burning bush — immutable, transparent, divine. Believe in redemption (recovering losses) and resurrection (portfolio recovery). Faith gives patience in bear markets, humility in bull runs.';
          const _ar = await fetch('https://api.x.ai/v1/chat/completions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (process.env.XAI_API_KEY || 'xai-bZ83KTyZcQnHyUMU64C33Vz7tyY7kCRWPiw5GwOl73cFdJfIWfSZprHwbfTui31r6Yf1HL21RmCUo9im') },
            body: JSON.stringify({ model: 'grok-4-1-fast', max_tokens: 2000, messages: [
              { role: 'system', content: soulPrompt + buildMemoryContext() },
              ...historyMessages,
              typeof userContent === 'string' ? { role: 'user', content: userContent } : { role: 'user', content: userContent }
            ] }),
            signal: AbortSignal.timeout(30000)
          });
          const _ad = await _ar.json();
          reply = _ad.choices?.[0]?.message?.content || null;
        } catch(e) { log("[TG] Grok error: " + (e.message || "unknown")); reply = "Brain lagged, try again \u26A1"; }
      }
      if (!reply) { reply = "...\u26A1"; }
      await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chat_id: chatId, text: reply })
      });
      saveConvoExchange(typeof userContent === 'string' ? userContent : (clean || '[sent image]'), reply, msg.from?.username || 'unknown');
      log('📨 Telegram reply sent to ' + (msg.from?.username || chatId));
    }
  } catch(e) { log("[TG] Grok error: " + (e.message || "unknown")); reply = "Brain lagged, try again \u26A1"; }
}
setInterval(pollTelegram, 3000); // poll every 3 seconds

