    fs.writeFileSync('/tmp/gizmo-tweet.txt', stoicTweet);
    execSync(`cd ${BASE_DIR} && node tweet.mjs "$(cat /tmp/gizmo-tweet.txt)"`, { timeout: 15000 });
    log('Stoic tweeted to X');
