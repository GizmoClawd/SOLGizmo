let SCORE_THRESHOLD = 5; // SURVIVAL: locked high
let MIN_LIQ = 8000;
let MIN_KOLS = 2;
let POSITION_SIZE_MULT = 1.0;

const LEARN_FILE = BASE_DIR + '/learn-state.json';
